<!-- Textured 8-quart stockpot for TwoArmLift-style envs.

     Visual: the .msh mesh (converted from 8_quart_pot.obj by obj2msh.py, UVs
     kept) with its color texture, group 1, non-colliding.
     Collision: invisible group-0 primitives. MuJoCo convexifies collision
     meshes, which would fill the bowl and the handle gaps, so instead the body
     is a solid cylinder and each handle's graspable crossbar is a capsule
     placed where the mesh's bar actually is (measured from the OBJ vertices:
     bar spans x 0.137..0.154 at z 0.062..0.078; wall radius ~0.115 leaves a
     ~2 cm gap for the inner finger, like the stock PotWithHandles).
     Frame: origin at the pot's volumetric center (mesh is symmetric, z +-0.0888),
     matching the stock pot's origin-at-center convention so TwoArmLift's
     pot-bottom math (center site z - top_offset z) holds. The mesh has its
     handles along +-x, but the two arms stand at +-y and the stock pot (which
     the spawn-yaw range was tuned for) carries handles on +-y; so the visual
     mesh is rotated +90deg about z (quat below) and the collision bars/sites
     are authored at +-y directly, bars running along x. -->
<mujoco model="pot_8qt">
  <asset>
    <mesh file="8_quart_pot.msh" name="pot_8qt_mesh"/>
    <texture type="2d" file="8_quart_pot_color.png" name="tex-pot-8qt"/>
    <material name="pot_8qt_mat" texture="tex-pot-8qt" specular="0.75" shininess="0.4"/>
  </asset>
  <worldbody>
    <body>
      <body name="object">
        <geom name="visual" mesh="pot_8qt_mesh" type="mesh" material="pot_8qt_mat"
              quat="0.7071068 0 0 0.7071068"
              contype="0" conaffinity="0" group="1" mass="1e-8"/>
        <!-- body collision stops WELL BELOW the handle bars (bar center z=0.0695):
             the bar sits only 2cm under the rim and 2.5cm off the wall, so a rim
             with collision blocks any Panda descent onto it. Top at z=0.04 lets a
             FULLY OPEN gripper (inner fingertip ~3cm inside the bar radius, tip
             bottom reaching z~0.045) descend without contact, keeping the stock
             pot's ~2.4cm radial grasp tolerance. Fingers may transiently clip the
             visual rim by ~1cm during the close; on a seated grasp they sit in the
             handle gap, which is real air in the mesh too. -->
        <geom name="body_col" type="cylinder" size="0.115 0.0644" pos="0 0 -0.0244"
              group="0" rgba="0.5 0.5 0.5 0" mass="0.9"
              solimp="0.998 0.998 0.001" solref="0.001 1" friction="0.95 0.3 0.1"/>
        <geom name="handle0_bar" type="capsule" size="0.008"
              fromto="-0.02 0.1455 0.0695 0.02 0.1455 0.0695"
              group="0" rgba="0.5 0.5 0.5 0" mass="0.05"
              solimp="0.998 0.998 0.001" solref="0.001 1" friction="1.0 0.005 0.0001"/>
        <geom name="handle1_bar" type="capsule" size="0.008"
              fromto="-0.02 -0.1455 0.0695 0.02 -0.1455 0.0695"
              group="0" rgba="0.5 0.5 0.5 0" mass="0.05"
              solimp="0.998 0.998 0.001" solref="0.001 1" friction="1.0 0.005 0.0001"/>
        <site name="handle0" pos="0 0.1455 0.0695" size="0.005" rgba="0 1 0 0"/>
        <site name="handle1" pos="0 -0.1455 0.0695" size="0.005" rgba="0 0 1 0"/>
        <site name="center" pos="0 0 0" size="0.005" rgba="1 0 0 0"/>
      </body>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 -0.0888" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.0888" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.1537 0 0" name="horizontal_radius_site"/>
    </body>
  </worldbody>
</mujoco>
